# Replace this value with the connection string copied from MongoDB Atlas.
# Do not commit the real .env file or share your database password.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=q4_food_guide
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Brevo Transactional Email API (HTTPS). Use a Brevo API key with transactional
# email sending permission and a sender address verified in Brevo.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=FoodTour

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
DEEPL_AUTH_KEY=your-deepl-api-auth-key
